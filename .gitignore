# Raw Kaggle data: never edited, never committed (download it again with the command in README)
data/raw/*
!data/raw/.gitkeep

# Secrets (only the template .env.example is committed)
.env
.env.*
!.env.example
kaggle.json
*credentials*
*secret*
*.pem
*.key

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Power BI / Excel backups and lock files
*.pbix.bak
powerbi/*Backup*
~$*.xlsx

# Power BI Project (PBIP): per-user settings and the local data cache (holds imported data) are never committed
**/.pbi/localSettings.json
**/.pbi/cache.abf
*.abf

# Generated temporary files
*.tmp
*.log
Thumbs.db
desktop.ini

# OS / editor
.DS_Store
.vscode/
.idea/

# Power BI CSV snapshots: regenerate with src/export_views.py, copy to the Windows PC (not versioned)
powerbi/data/
powerbi_data.zip
