// Stage 5 check: Power BI measures vs SQL (powerbi_expected_values.csv, seller_late_rate_ranking.csv, seller_scorecard_totals.csv).
// Generated by powerbi/tools/build_validation_query.py - do not edit by hand.
// Refresh the model first, then run this in DAX query view.
EVALUATE
VAR Checks =
    UNION (
    ROW ( "Check", 1, "Measure", "Total Revenue (R$)", "Context", "all valid orders 2017-01 to 2018-08",
          "Power BI", 1.0 * ( [Total Revenue (R$)] ),
          "SQL expected", 13449529.68, "Tolerance", 0.0050000000,
          "Detail", "" ),
    ROW ( "Check", 2, "Measure", "Orders", "Context", "all",
          "Power BI", 1.0 * ( [Orders] ),
          "SQL expected", 97905.0, "Tolerance", 0.0000000000,
          "Detail", "" ),
    ROW ( "Check", 3, "Measure", "AOV (R$)", "Context", "all",
          "Power BI", 1.0 * ( [AOV (R$)] ),
          "SQL expected", 137.3733, "Tolerance", 0.0000500000,
          "Detail", "" ),
    ROW ( "Check", 4, "Measure", "Customers", "Context", "all (distinct customer_unique_id)",
          "Power BI", 1.0 * ( [Customers] ),
          "SQL expected", 94703.0, "Tolerance", 0.0000000000,
          "Detail", "" ),
    ROW ( "Check", 5, "Measure", "Repeat Customer %", "Context", "all",
          "Power BI", 1.0 * ( 100 * [Repeat Customer %] ),
          "SQL expected", 3.0348, "Tolerance", 0.0000500000,
          "Detail", "" ),
    ROW ( "Check", 6, "Measure", "Delivered Orders (in scope)", "Context", "all",
          "Power BI", 1.0 * ( [Delivered Orders] ),
          "SQL expected", 96201.0, "Tolerance", 0.0000000000,
          "Detail", "" ),
    ROW ( "Check", 7, "Measure", "On-Time %", "Context", "all",
          "Power BI", 1.0 * ( 100 * [On-Time %] ),
          "SQL expected", 93.2111, "Tolerance", 0.0000500000,
          "Detail", "" ),
    ROW ( "Check", 8, "Measure", "Late %", "Context", "all",
          "Power BI", 1.0 * ( 100 * [Late %] ),
          "SQL expected", 6.7889, "Tolerance", 0.0000500000,
          "Detail", "" ),
    ROW ( "Check", 9, "Measure", "Avg Delay (days)", "Context", "all (negative = early)",
          "Power BI", 1.0 * ( [Avg Delay (days)] ),
          "SQL expected", -11.8071, "Tolerance", 0.0000500000,
          "Detail", "" ),
    ROW ( "Check", 10, "Measure", "Avg Delivery Days", "Context", "all",
          "Power BI", 1.0 * ( [Avg Delivery Days] ),
          "SQL expected", 12.4768, "Tolerance", 0.0000500000,
          "Detail", "" ),
    ROW ( "Check", 11, "Measure", "Avg Review", "Context", "all valid orders with a review",
          "Power BI", 1.0 * ( [Avg Review] ),
          "SQL expected", 4.1173, "Tolerance", 0.0000500000,
          "Detail", "" ),
    ROW ( "Check", 12, "Measure", "Avg Review (delivered)", "Context", "orders in delivery scope with a review",
          "Power BI", 1.0 * ( [Avg Review (delivered)] ),
          "SQL expected", 4.1563, "Tolerance", 0.0000500000,
          "Detail", "" ),
    ROW ( "Check", 13, "Measure", "Revenue MoM %", "Context", "month = 2018-08 (vs 2018-07)",
          "Power BI", 1.0 * ( 100 * CALCULATE ( [Revenue MoM %], dim_date[year_month_label] = "2018-08" ) ),
          "SQL expected", -3.3238, "Tolerance", 0.0000500000,
          "Detail", "" ),
    ROW ( "Check", 14, "Measure", "Revenue MoM %", "Context", "month = 2017-11 (vs 2017-10)",
          "Power BI", 1.0 * ( 100 * CALCULATE ( [Revenue MoM %], dim_date[year_month_label] = "2017-11" ) ),
          "SQL expected", 52.0589, "Tolerance", 0.0000500000,
          "Detail", "" ),
    ROW ( "Check", 15, "Measure", "Excess Late Orders", "Context", "sellers with 30+ delivered orders (is_ranked_30plus_orders = 1)",
          "Power BI", 1.0 * ( CALCULATE ( [Excess Late Orders], dim_seller[is_ranked_30plus_orders] = 1 ) ),
          "SQL expected", -45.41, "Tolerance", 0.0050000000,
          "Detail", "" ),
    ROW ( "Check", 16, "Measure", "Excess Late Orders", "Context", "top seller by excess (rank 1)",
          "Power BI", 1.0 * ( CALCULATE ( VAR TopSellers = TOPN ( 1, ADDCOLUMNS ( VALUES ( dim_seller[seller_id] ), "@Excess", [Excess Late Orders] ), [@Excess], DESC ) RETURN IF ( CONCATENATEX ( TopSellers, dim_seller[seller_id], ", " ) = "4a3ca9315b744ce9f8e9374361493884", MAXX ( TopSellers, [@Excess] ) ), dim_seller[is_ranked_30plus_orders] = 1 ) ),
          "SQL expected", 51.7, "Tolerance", 0.0050000000,
          "Detail", "Expected seller 4a3ca9315b744ce9f8e9374361493884; Power BI top seller: " & CALCULATE ( VAR TopSellers = TOPN ( 1, ADDCOLUMNS ( VALUES ( dim_seller[seller_id] ), "@Excess", [Excess Late Orders] ), [@Excess], DESC ) RETURN CONCATENATEX ( TopSellers, dim_seller[seller_id], ", " ), dim_seller[is_ranked_30plus_orders] = 1 ) ),
    ROW ( "Check", 17, "Measure", "Seller Late %", "Context", "sellers with 30+ delivered orders (seller-order pairs)",
          "Power BI", 1.0 * ( 100 * CALCULATE ( [Seller Late % (pairs)], dim_seller[is_ranked_30plus_orders] = 1 ) ),
          "SQL expected", 6.7331, "Tolerance", 0.0000500000,
          "Detail", "" ),
    ROW ( "Check", 18, "Measure", "Platform Late Rate", "Context", "no filters (equals overall Late %)",
          "Power BI", 1.0 * ( 100 * [Platform Late Rate] ),
          "SQL expected", 6.7889, "Tolerance", 0.0000500000,
          "Detail", "" ),
    ROW ( "Check", 19, "Measure", "Platform Late Rate", "Context", "customer state SP and month 2018-03 (must not change)",
          "Power BI", 1.0 * ( 100 * CALCULATE ( [Platform Late Rate], dim_customer[customer_state] = "SP", dim_date[year_month_label] = "2018-03" ) ),
          "SQL expected", 6.7889, "Tolerance", 0.0000500000,
          "Detail", "Late % with these filters: " & FORMAT ( 100 * CALCULATE ( [Late %], dim_customer[customer_state] = "SP", dim_date[year_month_label] = "2018-03" ), "0.0000" ) )
    )
RETURN
    ADDCOLUMNS (
        Checks,
        "Difference", [Power BI] - [SQL expected],
        "Result", IF ( NOT ISBLANK ( [Power BI] ) && ABS ( [Power BI] - [SQL expected] ) <= [Tolerance], "PASS", "FAIL" )
    )
ORDER BY [Check]
