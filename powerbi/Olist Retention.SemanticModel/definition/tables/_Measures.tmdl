/// All report measures, grouped in display folders (see powerbi/dax_measures.md).
table _Measures
	lineageTag: d6dc8bef-2274-58cd-bc0a-07a3e3ae1e14

	/// Product revenue of valid orders, excluding freight.
	measure 'Total Revenue (R$)' = SUM ( fact_orders[order_revenue] )
		formatString: R$ #,0.00
		displayFolder: Revenue
		lineageTag: 77d5b73e-b1c5-5362-ab6a-371a5bdc3bb7

	/// Number of valid orders.
	measure Orders = COUNTROWS ( fact_orders )
		formatString: #,0
		displayFolder: Revenue
		lineageTag: 0632c9de-10fe-58a2-b223-2ceb7314bdb0

	/// Average product value per valid order.
	measure 'AOV (R$)' = DIVIDE ( [Total Revenue (R$)], [Orders] )
		formatString: R$ #,0.00
		displayFolder: Revenue
		lineageTag: f4ec1160-a7d2-54ef-a824-c35893c93c46

	/// Revenue of the previous calendar month.
	measure 'Previous Month Revenue (R$)' = CALCULATE ( [Total Revenue (R$)], DATEADD ( dim_date[date_key], -1, MONTH ) )
		formatString: R$ #,0.00
		displayFolder: Revenue
		lineageTag: 292b277f-a8f3-52c6-818f-5562f0b15773

	/// Change vs the previous calendar month; needs a month in context.
	measure 'Revenue MoM %' =
			VAR CurrentRevenue  = [Total Revenue (R$)]
			VAR PreviousRevenue = [Previous Month Revenue (R$)]
			RETURN
			    IF ( NOT ISBLANK ( PreviousRevenue ), DIVIDE ( CurrentRevenue - PreviousRevenue, PreviousRevenue ) )
		formatString: 0.00%
		displayFolder: Revenue
		lineageTag: 75b2f7fe-a652-5c0c-8993-86f9fc256b05

	/// Revenue minus previous month revenue.
	measure 'Revenue Change vs Previous Month (R$)' =
			VAR PreviousRevenue = [Previous Month Revenue (R$)]
			RETURN
			    IF ( NOT ISBLANK ( PreviousRevenue ), [Total Revenue (R$)] - PreviousRevenue )
		formatString: R$ #,0.00
		displayFolder: Revenue
		lineageTag: 25d762a9-b10d-5346-9df6-7ac586aeb0c9

	/// Revenue at item level, for product and seller analysis.
	measure 'Item Revenue (R$)' = SUM ( fact_order_items[price] )
		formatString: R$ #,0.00
		displayFolder: Revenue
		lineageTag: e8513d16-61a6-5fb6-8873-7cb9dae7e080

	/// Distinct orders with at least one item in context.
	measure 'Item Orders' = DISTINCTCOUNT ( fact_order_items[order_id] )
		formatString: #,0
		displayFolder: Revenue
		lineageTag: ed04ccf6-7d22-5fc1-82ab-c772c3743368

	/// Running share of revenue, highest category first.
	measure 'Category Cumulative Revenue %' =
			VAR CurrentRevenue = [Item Revenue (R$)]
			VAR AllCategories  = ALLSELECTED ( dim_product[category_english] )
			VAR CategoriesAtOrAbove =
			    FILTER ( AllCategories, [Item Revenue (R$)] >= CurrentRevenue )
			RETURN
			    DIVIDE ( SUMX ( CategoriesAtOrAbove, [Item Revenue (R$)] ),
			             SUMX ( AllCategories, [Item Revenue (R$)] ) )
		formatString: 0.00%
		displayFolder: Revenue\Pareto
		lineageTag: 7a4bad33-199e-504f-bb48-6dd1cea520d3

	/// Category share of item revenue.
	measure 'Category Revenue Share %' = DIVIDE ( [Item Revenue (R$)], CALCULATE ( [Item Revenue (R$)], ALLSELECTED ( dim_product[category_english] ) ) )
		formatString: 0.00%
		displayFolder: Revenue\Pareto
		lineageTag: d6d89b5c-9f7f-5880-9d02-01f48d80970e

	/// Rank of the category by item revenue.
	measure 'Category Revenue Rank' =
			IF (
			    ISINSCOPE ( dim_product[category_english] ),
			    RANKX ( ALLSELECTED ( dim_product[category_english] ), [Item Revenue (R$)], , DESC )
			)
		formatString: #,0
		displayFolder: Revenue\Pareto
		lineageTag: 32331a82-e0ed-5317-b978-d156187e8c8d

	/// Number of categories needed to reach 80% of revenue.
	measure 'Categories for 80% Revenue' =
			COUNTROWS (
			    FILTER ( ALLSELECTED ( dim_product[category_english] ), [Category Cumulative Revenue %] < 0.8 )
			) + 1
		formatString: #,0
		displayFolder: Revenue\Pareto
		lineageTag: d982d2b5-2164-56fa-a4cf-2e88d9195b74

	/// Customer-state share of revenue.
	measure 'State Revenue Share %' = DIVIDE ( [Total Revenue (R$)], CALCULATE ( [Total Revenue (R$)], ALLSELECTED ( dim_customer[customer_state] ) ) )
		formatString: 0.00%
		displayFolder: Revenue\Pareto
		lineageTag: ae4bc5cb-b6e4-541e-85b6-190dd7636f47

	/// Running share of revenue, highest state first.
	measure 'State Cumulative Revenue %' =
			VAR CurrentRevenue = [Total Revenue (R$)]
			VAR AllStates      = ALLSELECTED ( dim_customer[customer_state] )
			VAR StatesAtOrAbove = FILTER ( AllStates, [Total Revenue (R$)] >= CurrentRevenue )
			RETURN
			    DIVIDE ( SUMX ( StatesAtOrAbove, [Total Revenue (R$)] ), SUMX ( AllStates, [Total Revenue (R$)] ) )
		formatString: 0.00%
		displayFolder: Revenue\Pareto
		lineageTag: b37f4105-ab2c-5bff-a9bf-da6218d54e40

	/// Number of customer states needed to reach 80% of revenue.
	measure 'States for 80% Revenue' = COUNTROWS ( FILTER ( ALLSELECTED ( dim_customer[customer_state] ), [State Cumulative Revenue %] < 0.8 ) ) + 1
		formatString: #,0
		displayFolder: Revenue\Pareto
		lineageTag: c8ad1c0c-c3f4-5026-bf2b-0cd4e902d40c

	/// Distinct people (customer_unique_id) with a valid order in context.
	measure Customers = CALCULATE ( DISTINCTCOUNT ( dim_customer[customer_unique_id] ), fact_orders )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 9b21c87e-3c8d-5302-ab32-f14a5f020866

	/// Share of people with 2+ valid orders inside the selected period.
	measure 'Repeat Customer %' =
			VAR OrdersPerCustomer =
			    ADDCOLUMNS (
			        VALUES ( dim_customer[customer_unique_id] ),
			        "@Orders", CALCULATE ( COUNTROWS ( fact_orders ) )
			    )
			VAR CustomersWithOrders = COUNTROWS ( FILTER ( OrdersPerCustomer, [@Orders] >= 1 ) )
			VAR RepeatCustomers     = COUNTROWS ( FILTER ( OrdersPerCustomer, [@Orders] >= 2 ) )
			RETURN
			    DIVIDE ( RepeatCustomers, CustomersWithOrders )
		formatString: 0.00%
		displayFolder: Customers
		lineageTag: 7c50960b-fcbf-542e-a574-ee0f1e8c7cee

	/// People with 2+ valid orders inside the selected period.
	measure 'Repeat Customers' =
			VAR OrdersPerCustomer =
			    ADDCOLUMNS (
			        VALUES ( dim_customer[customer_unique_id] ),
			        "@Orders", CALCULATE ( COUNTROWS ( fact_orders ) )
			    )
			RETURN
			    COUNTROWS ( FILTER ( OrdersPerCustomer, [@Orders] >= 2 ) )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 5597db4a-08ed-5458-acaa-74d5fb9215b4

	/// People with exactly 1 valid order inside the selected period.
	measure 'One-time Customers' =
			VAR OrdersPerCustomer =
			    ADDCOLUMNS (
			        VALUES ( dim_customer[customer_unique_id] ),
			        "@Orders", CALCULATE ( COUNTROWS ( fact_orders ) )
			    )
			RETURN
			    COUNTROWS ( FILTER ( OrdersPerCustomer, [@Orders] = 1 ) )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 9ffb00d1-9d5f-56a7-a33d-baaae63d8755

	/// Valid orders per person.
	measure 'Orders per Customer' = DIVIDE ( [Orders], [Customers] )
		formatString: 0.0000
		displayFolder: Customers
		lineageTag: aaaceff4-f79b-5ac9-abe0-b50012fac69f

	/// People in the cohort (month of first valid order).
	measure 'Cohort Customers' = DISTINCTCOUNT ( dim_customer[customer_unique_id] )
		formatString: #,0
		displayFolder: Customers\Cohort
		lineageTag: fe3b00bd-6f72-50b3-8d48-b714163481b6

	/// Cohort members with a valid order N months after their first month; blank when not yet observable.
	measure 'Cohort Active Customers' =
			VAR CohortStart    = SELECTEDVALUE ( dim_customer[cohort_month] )
			VAR MonthOffset    = SELECTEDVALUE ( 'Cohort Month Offset'[month_offset] )
			VAR TargetMonth    = EDATE ( CohortStart, MonthOffset )
			VAR LastOrderDate  = CALCULATE ( MAX ( fact_orders[purchase_date] ), REMOVEFILTERS () )
			VAR LastDataMonth  = DATE ( YEAR ( LastOrderDate ), MONTH ( LastOrderDate ), 1 )
			RETURN
			    IF (
			        NOT ISBLANK ( CohortStart ) && NOT ISBLANK ( MonthOffset ) && TargetMonth <= LastDataMonth,
			        CALCULATE ( [Customers], REMOVEFILTERS ( dim_date ), dim_date[month_start] = TargetMonth ) + 0
			    )
		formatString: #,0
		displayFolder: Customers\Cohort
		lineageTag: 18917b2f-0f38-5e70-b6fa-3edc80b42eb9

	/// Cohort Active Customers / Cohort Customers.
	measure 'Cohort Retention % (live)' =
			VAR ActiveCustomers = [Cohort Active Customers]
			RETURN
			    IF ( NOT ISBLANK ( ActiveCustomers ), DIVIDE ( ActiveCustomers, [Cohort Customers] ) )
		formatString: 0.00%
		displayFolder: Customers\Cohort
		lineageTag: 11d44729-8028-5795-ab99-7091c714fb9f

	/// Orders in delivery scope.
	measure 'Delivered Orders' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[in_delivery_scope] = 1 )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 8851f330-e12a-5b7f-9a75-e1b03ead4668

	/// Delivered on or before the estimated date.
	measure 'On-Time Orders' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_on_time] = 1 )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 2d0d6b85-83f2-56cf-bfb6-55153ea681c6

	/// Delivered after the estimated date.
	measure 'Late Orders' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_late] = 1 )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: c7b79f9f-a2e7-5486-81f1-9d7383c5c21f

	/// Share of delivered orders on or before the estimated date.
	measure 'On-Time %' = DIVIDE ( [On-Time Orders], [Delivered Orders] )
		formatString: 0.00%
		displayFolder: Delivery
		lineageTag: 3397d201-543b-544a-ade4-276365692e16

	/// Share of delivered orders after the estimated date.
	measure 'Late %' = DIVIDE ( [Late Orders], [Delivered Orders] )
		formatString: 0.00%
		displayFolder: Delivery
		lineageTag: 6e0b32af-4a73-516e-8016-9a697487f64c

	/// Days delivered after (+) or before (-) the estimate.
	measure 'Avg Delay (days)' = AVERAGE ( fact_orders[delay_days] )
		formatString: 0.00
		displayFolder: Delivery
		lineageTag: 462a2630-1737-5e58-a363-f71ca993ad72

	/// Purchase to delivery, in days.
	measure 'Avg Delivery Days' = AVERAGE ( fact_orders[delivery_days] )
		formatString: 0.00
		displayFolder: Delivery
		lineageTag: 9bdc31a2-055e-5d18-bae2-6ad4aa5a5163

	/// Late % of the whole platform, ignoring all filters.
	measure 'Platform Late Rate' = CALCULATE ( [Late %], REMOVEFILTERS () )
		formatString: 0.00%
		displayFolder: Delivery
		lineageTag: 24608a47-36e7-5a59-b9ec-4b7b0b948b72

	/// Late % minus the platform late rate.
	measure 'Late % vs Platform (pp)' = [Late %] - [Platform Late Rate]
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Delivery
		lineageTag: 66fade38-a1f1-5535-b47c-b27bc75c8e3f

	/// Average review score (1-5) of valid orders with a review.
	measure 'Avg Review' = AVERAGE ( fact_orders[review_score] )
		formatString: 0.00
		displayFolder: Satisfaction
		lineageTag: 2e66848c-5981-54ab-a2d4-9a5f33e265ea

	/// Average review score of delivered orders.
	measure 'Avg Review (delivered)' = CALCULATE ( AVERAGE ( fact_orders[review_score] ), fact_orders[in_delivery_scope] = 1 )
		formatString: 0.00
		displayFolder: Satisfaction
		lineageTag: e7d75d1e-0de7-5a44-b264-3a2cfa739418

	/// Distinct delivered orders of the sellers in context (use for one seller).
	measure 'Seller Delivered Orders' = CALCULATE ( DISTINCTCOUNT ( fact_order_items[order_id] ), fact_order_items[in_delivery_scope] = 1 )
		formatString: #,0
		displayFolder: Sellers
		lineageTag: c0e2034e-a141-55bc-a988-9787624af5f0

	/// Distinct late orders of the sellers in context (use for one seller).
	measure 'Seller Late Orders' = CALCULATE ( DISTINCTCOUNT ( fact_order_items[order_id] ), fact_order_items[is_late] = 1 )
		formatString: #,0
		displayFolder: Sellers
		lineageTag: 30a9e7f2-cdca-5bfd-b1cc-836a53274849

	/// Late rate on distinct orders (identical to the pair version for one seller).
	measure 'Seller Late %' = DIVIDE ( [Seller Late Orders], [Seller Delivered Orders] )
		formatString: 0.00%
		displayFolder: Sellers
		lineageTag: 5e1fae7d-54d1-5393-8266-76a06dbf9122

	/// Late rate on seller-order pairs: the SQL definition for groups of sellers.
	measure 'Seller Late % (pairs)' = DIVIDE ( [Late Orders (seller sum)], [Delivered Orders (seller sum)] )
		formatString: 0.00%
		displayFolder: Sellers
		lineageTag: 8c8c49ca-b0af-5977-b6f0-bd092e3febb1

	/// Late orders above what an average seller of the same size would have.
	measure 'Excess Late Orders' =
			SUMX (
			    VALUES ( dim_seller[seller_id] ),
			    [Seller Late Orders] - [Seller Delivered Orders] * [Platform Late Rate]
			)
		formatString: #,0.00
		displayFolder: Sellers
		lineageTag: b6af6260-bbb4-59e4-8e67-c778153e4bfb

	/// One review score per order, delivered orders only.
	measure 'Seller Avg Review' =
			AVERAGEX (
			    SUMMARIZE (
			        FILTER ( fact_order_items, fact_order_items[in_delivery_scope] = 1 ),
			        fact_order_items[order_id], fact_order_items[review_score]
			    ),
			    fact_order_items[review_score]
			)
		formatString: 0.00
		displayFolder: Sellers
		lineageTag: 96e19862-79f7-59eb-bcac-d2a8135bce9d

	/// One delay value per order, delivered orders only.
	measure 'Seller Avg Delay (days)' =
			AVERAGEX (
			    SUMMARIZE (
			        FILTER ( fact_order_items, fact_order_items[in_delivery_scope] = 1 ),
			        fact_order_items[order_id], fact_order_items[delay_days]
			    ),
			    fact_order_items[delay_days]
			)
		formatString: 0.00
		displayFolder: Sellers
		lineageTag: eb00b1dc-0405-5387-8f35-93b2eb41f093

	/// Item revenue of the sellers in context.
	measure 'Seller Revenue (R$)' = SUM ( fact_order_items[price] )
		formatString: R$ #,0.00
		displayFolder: Sellers
		lineageTag: 7fb5bf62-9f61-56f8-bfa1-5df66da6745f

	/// Sellers with at least one item in context.
	measure 'Total Sellers' = DISTINCTCOUNT ( fact_order_items[seller_id] )
		formatString: #,0
		displayFolder: Sellers
		lineageTag: 16fd33eb-c711-5bf1-9fef-1d19c0dd919f

	/// Sellers with 30+ delivered orders (SQL threshold).
	measure 'Ranked Sellers' = CALCULATE ( [Total Sellers], dim_seller[is_ranked_30plus_orders] = 1 )
		formatString: #,0
		displayFolder: Sellers
		lineageTag: 644fe98b-4dd4-52cd-82dd-1197ed64b761

	/// SQL late-rate rank (ranked sellers only).
	measure 'Seller Late Rate Rank' = SELECTEDVALUE ( dim_seller[late_rate_rank] )
		formatString: #,0
		displayFolder: Sellers
		lineageTag: e150c9a7-3639-5e62-8ec3-ea731dcccb07

	/// Rank of the seller by Excess Late Orders among the sellers shown.
	measure 'Excess Late Rank' =
			IF (
			    ISINSCOPE ( dim_seller[seller_id] ),
			    RANKX ( ALLSELECTED ( dim_seller[seller_id] ), [Excess Late Orders], , DESC )
			)
		formatString: #,0
		displayFolder: Sellers
		lineageTag: 2079cf9b-c278-5037-9223-eb96fe09e0a5

	/// Share of seller late orders (pairs) in the selected deciles.
	measure 'Share of Seller Late Orders' =
			DIVIDE ( [Late Orders (seller sum)],
			         CALCULATE ( [Late Orders (seller sum)], REMOVEFILTERS ( dim_seller[late_rate_decile] ) ) )
		formatString: 0.00%
		displayFolder: Sellers
		lineageTag: ef5c8d69-0898-58f0-8293-265435b3ef25

	/// Dynamic title for the drill-through page.
	measure 'Seller Detail Title' =
			"Seller " & SELECTEDVALUE ( dim_seller[seller_id], "(select one seller)" )
			    & "  |  " & SELECTEDVALUE ( dim_seller[seller_city] ) & " - " & SELECTEDVALUE ( dim_seller[seller_state] )
		displayFolder: Sellers
		lineageTag: fbad2e6c-ae13-5632-bfa5-5aa9bff90a03

	/// Late seller-order pairs, summed seller by seller.
	measure 'Late Orders (seller sum)' = SUMX ( VALUES ( dim_seller[seller_id] ), [Seller Late Orders] )
		formatString: #,0
		displayFolder: Sellers\Helpers
		lineageTag: 648d3dd9-8be3-5f1f-a4d9-cc1e45b77a24

	/// Delivered seller-order pairs, summed seller by seller.
	measure 'Delivered Orders (seller sum)' = SUMX ( VALUES ( dim_seller[seller_id] ), [Seller Delivered Orders] )
		formatString: #,0
		displayFolder: Sellers\Helpers
		lineageTag: 9588fbab-d815-5ea3-a00e-1bbc8c4a5276

	/// Orange when Late % is above the platform, else blue.
	measure 'Colour - Late vs Platform' = IF ( [Late %] > [Platform Late Rate], "#EB6834", "#2A78D6" )
		displayFolder: Formatting
		lineageTag: 94a2e1af-f3c5-50cd-b4cf-ad97e4cbce2d

	/// Orange when Seller Late % is above the platform, else blue.
	measure 'Colour - Seller Late vs Platform' = IF ( [Seller Late %] > [Platform Late Rate], "#EB6834", "#2A78D6" )
		displayFolder: Formatting
		lineageTag: 810d173f-098d-5690-bf7d-cc73b42d5325

	/// Orange when Seller Late % (pairs) is above the platform, else blue (for groups of sellers).
	measure 'Colour - Seller Late (pairs) vs Platform' = IF ( [Seller Late % (pairs)] > [Platform Late Rate], "#EB6834", "#2A78D6" )
		displayFolder: Formatting
		lineageTag: 2e31f7df-29df-55ad-bca4-016e110d242c

	/// Orange for late delay buckets (1-3, 4-7, 7+ days late), else blue.
	measure 'Colour - Late Bucket' = IF ( MAX ( fact_orders[delay_bucket_order] ) >= 3, "#EB6834", "#2A78D6" )
		displayFolder: Formatting
		lineageTag: 32c5cc2a-dc74-57c8-8eb0-7bbe47ef953a

	column Value
		dataType: int64
		isHidden
		isNameInferred
		lineageTag: e855b42a-b0f0-55fd-b076-f3d003bbe4b6
		summarizeBy: none
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = { 0 }

	annotation PBI_Id = measures-table
