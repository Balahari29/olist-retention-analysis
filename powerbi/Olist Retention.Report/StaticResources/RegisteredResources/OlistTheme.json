{
  "name": "Olist Retention",
  "dataColors": [
    "#2A78D6",
    "#B5B4AF",
    "#EB6834",
    "#1B4F8C",
    "#7FB2EB",
    "#52514E",
    "#F2A27F",
    "#3F8F6B"
  ],
  "background": "#FFFFFF",
  "foreground": "#0B0B0B",
  "tableAccent": "#2A78D6",
  "good": "#2A78D6",
  "neutral": "#B5B4AF",
  "bad": "#EB6834",
  "maximum": "#2A78D6",
  "center": "#9CC3EE",
  "minimum": "#FFFFFF",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0B0B0B"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0B0B0B"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#52514E"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#2A78D6"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E2DE"
              }
            },
            "radius": 8
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontSize": 12
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "fontSize": 9
          }
        ]
      }
